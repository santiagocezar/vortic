   "id": "48e24a4d-4b47-4203-929b-0191fd53a18e",
   "name": "¿Hay órdenes activas?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    720,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "// Arma el pedido al modelo de IA con las reglas del taller (vienen del\n// backend) y las órdenes activas anonimizadas.\nconst datos = $input.first().json;\nconst cfg = $('Configuración').first().json;\n\nconst sistema = [\n  'Sos el asistente de planificación de un taller de reparación oleohidráulica.',\n  'Tenés que ordenar las órdenes de trabajo activas según las reglas del taller.',\n  'Reglas:',\n  ...datos.reglas.map((r, i) => `${i + 1}. ${r}`),\n  '',\n  'Respondé SOLO con un objeto JSON, sin texto antes ni después, con esta forma exacta:',\n  '{\"resultados\": [{\"orden_id\": <número>, \"puntaje\": <número de 0 a 100>, \"justificacion\": \"<una o dos oraciones>\"}]}',\n  'Incluí todas las órdenes recibidas, una sola vez cada una. Mayor puntaje = atender antes.',\n  'La justificación tiene que nombrar los factores concretos de esa orden (criticidad, repuestos, días, tiempo) y no superar los 200 caracteres.',\n].join('\\n');\n\nconst body = {\n  model: cfg.modelo,\n  max_tokens: 4000,\n  system: sistema,\n  messages: [\n    { role: 'user', content: 'Órdenes activas:\\n' + JSON.stringify(datos.ordenes, null, 1) },\n  ],\n};\n\nreturn [{ json: { body, ordenes_enviadas: datos.ordenes.map(o => o.orden_id) } }];\n"
   },
   "id": "e7d539fb-de20-4bb3-9a8e-1a216b51283a",
   "name": "Armar pedido a la IA",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    960,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Configuración').first().json.url_modelo }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {
     "timeout": 60000
    },
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.body) }}"
   },
   "id": "6950c943-ceb6-45df-bfb3-b975176b5151",
   "name": "Consultar modelo de IA",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1200,
    0
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "anthropicApiKey",
     "name": "Anthropic - clave de API"
    }
   },
   "onError": "continueErrorOutput"
  },
  {
   "parameters": {
    "jsCode": "// Interpreta la respuesta del modelo. Si no es un JSON con la forma\n// esperada, se marca como inválida y el flujo aplica la regla de respaldo.\n// El backend vuelve a validar cada orden (puntaje de 0 a 100, orden activa,\n// sin repetidas) y completa con la regla las que falten.\nconst r = $input.first().json;\nlet resultados = null;\nlet error = '';\ntry {\n  const texto = (r.content || []).filter(c => c.type === 'text').map(c => c.text).join('').trim();\n  const limpio = texto.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '');\n  const obj = JSON.parse(limpio);\n  if (!Array.isArray(obj.resultados)) throw new Error('falta la lista \"resultados\"');\n  resultados = obj.resultados\n    .filter(x => x && Number.isFinite(Number(x.orden_id)) && Number.isFinite(Number(x.puntaje)))\n    .map(x => ({\n      orden_id: Number(x.orden_id),\n      puntaje: Math.max(0, Math.min(100, Number(x.puntaje))),\n      justificacion: String(x.justificacion || '').slice(0, 300),\n    }));\n  if (resultados.length === 0) throw new Error('lista vacía');\n} catch (e) {\n  error = String(e.message || e);\n  resultados = null;\n}\nreturn [{ json: { valido: resultados !== null, resultados, error } }];\n"
   },
   "id": "1bb86c51-ce54-45b9-90a5-6db543cf56d4",
   "name": "Validar respuesta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1440,
