# Copiar a .env y completar. El archivo .env no se sube al repositorio.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# Vacío = SQLite local. En Render se completa solo con la base PostgreSQL.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FEATURE_STOCK_PROVEEDORES=True
# Motor de priorización (n8n). Vacíos = solo regla de respaldo.
# Con n8n en Docker (ver README):
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/vortic-priorizar
# N8N_WEBHOOK_SECRETO=una-clave-que-inventes
# MOTOR_TOKEN=otra-clave-que-inventes
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRETO=
MOTOR_TOKEN=
